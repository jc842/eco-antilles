---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.lang || data.lang === 'fr');
allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1, 7);
---

<Layout title="Éco-Antilles — Observatoire de la Transition Écologique & Énergies Renouvelables" description="L'observatoire caribéen des solutions d'autonomie insulaire : dimensionnement solaire photovoltaïque, citernes d'eau pluviale, éco-habitat bioclimatique et préservation du littoral.">
  <!-- Hero Section Style Lexington Kotei (Deep Forest Green / Sage / Solar Amber) -->
  <section class="relative bg-emerald-950 text-white overflow-hidden border-b border-emerald-900">
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#34d399_1px,transparent_1px)] [background-size:28px_28px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-900/80 text-emerald-300 border border-emerald-700 mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Observatoire Caribéen de l'Autonomie Énergétique & Environnementale
          </div>
          
          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight font-sans">
            Bâtir l'<span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300">Autonomie Insulaire</span> Durable
          </h1>
          
          <p class="mt-6 text-lg sm:text-xl text-emerald-100 max-w-2xl font-normal leading-relaxed">
            Installations solaires photovoltaïques cycloniques, dimensionnement de citernes pluviales, architecture bioclimatique tropicale et valorisation des écosystèmes côtiers.
          </p>

          <div class="mt-8 flex flex-wrap gap-4 items-center">
            <a href="#dossiers" class="px-6 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-bold text-sm tracking-wide transition-all shadow-lg shadow-emerald-500/25">
              Consulter les 200 Dossiers &darr;
            </a>
            <a href="/blog/" class="px-6 py-3.5 rounded-xl bg-emerald-900/60 hover:bg-emerald-900 text-white font-semibold text-sm border border-emerald-700 transition-all">
              Index des Publications &rarr;
            </a>
          </div>

          <!-- Kotei Eco-Metrics Bar -->
          <div class="mt-12 grid grid-cols-3 gap-6 pt-8 border-t border-emerald-900">
            <div>
              <div class="text-2xl sm:text-3xl font-black text-amber-300 font-mono">260 km/h</div>
              <div class="text-xs text-emerald-300 mt-1">Résistance Solaire Cyclonique</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-white font-mono">100% Eau</div>
              <div class="text-xs text-emerald-300 mt-1">Autonomie Citernes Pluviales</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">LiFePO4</div>
              <div class="text-xs text-emerald-300 mt-1">Stockage Lithium Sécurisé</div>
            </div>
          </div>
        </div>

        <!-- Featured Card -->
        {featuredPost && (
          <div class="lg:col-span-5">
            <div class="bg-emerald-900/80 border border-emerald-700/80 rounded-3xl p-6 sm:p-8 relative shadow-2xl group hover:border-emerald-400/50 transition-all backdrop-blur-sm">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-300 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-800">
                  Dossier Écologique à la Une
                </span>
                <span class="text-xs text-emerald-300 font-mono">
                  {new Date(featuredPost.data.pubDate).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h2 class="text-2xl font-bold text-white group-hover:text-emerald-200 transition-colors leading-snug">
                <a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
              </h2>
              {featuredPost.data.description && (
                <p class="mt-3 text-emerald-200 text-sm line-clamp-3 leading-relaxed">
                  {featuredPost.data.description}
                </p>
              )}
              <div class="mt-6 pt-6 border-t border-emerald-800 flex items-center justify-between">
                <span class="text-xs text-emerald-300 font-medium">Filière: <strong class="text-white">{featuredPost.data.category}</strong></span>
                <a href={`/blog/${featuredPost.id}/`} class="text-xs font-bold text-emerald-300 group-hover:text-emerald-100 flex items-center gap-1">
                  Lire l'étude &rarr;
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Bento Grid Section -->
  <section id="dossiers" class="py-20 bg-emerald-900/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-2">Ingénierie Verte & Pratiques Insulaires</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">Les Filières Clés de la Rénovation Écologique</p>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-400">Des guides concrets pour rendre votre habitat autonome et résilient face aux aléas climatiques.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <article class="bg-white dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 rounded-2xl p-6 hover:border-emerald-400 transition-all flex flex-col justify-between group shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                  {post.data.category || 'Transition'}
                </span>
                <span class="text-xs text-emerald-600/70">
                  {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-emerald-400 transition-colors line-clamp-2 mb-2">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              {post.data.description && (
                <p class="text-sm text-slate-600 dark:text-emerald-200/80 line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </div>
            <div class="mt-6 pt-4 border-t border-emerald-100 dark:border-emerald-800/80 flex items-center justify-between">
              <span class="text-xs text-emerald-700 dark:text-emerald-400">Étude certifiée</span>
              <a href={`/blog/${post.id}/`} class="text-xs font-bold text-emerald-700 dark:text-emerald-300 group-hover:translate-x-1 transition-transform">
                Explorer &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/blog/" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-emerald-900 text-white dark:bg-white dark:text-emerald-950 font-bold text-sm hover:bg-emerald-600 dark:hover:bg-emerald-300 transition-all shadow-md">
          Consulter l'Ensemble des 200 Guides & Enquêtes &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- International Callout -->
  <section class="py-12 border-t border-emerald-900 bg-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-4">International Editions / Ediciones Internacionales</p>
      <div class="flex justify-center items-center gap-6 text-sm font-semibold">
        <a href="/en/" class="text-emerald-300 hover:underline flex items-center gap-1.5">
          <span>🇬🇧</span> English Edition (Caribbean Ecological Transition & Solar Autonomy)
        </a>
        <span class="text-emerald-700">|</span>
        <a href="/es/" class="text-emerald-300 hover:underline flex items-center gap-1.5">
          <span>🇪🇸</span> Edición en Español (Transición Ecológica del Caribe)
        </a>
      </div>
    </div>
  </section>
</Layout>
