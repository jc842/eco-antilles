---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.lang === 'es');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Éco-Antilles — Transición Ecológica y Energías Limpias en el Caribe (Edición en Español)" description="Plataforma de sostenibilidad insular: energía solar fotovoltaica, captación de agua de lluvia y diseño bioclimático tropical." lang="es">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-300 mb-4">
        Edición en Español
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-emerald-950 tracking-tight">
        Transición Ecológica del Caribe
      </h1>
      <p class="mt-4 text-lg text-emerald-800">
        Información técnica para lograr la independencia energética en islas, almacenamiento en litio y conservación de ecosistemas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <article class="bg-white border border-emerald-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <span class="inline-block text-xs font-bold text-emerald-700 uppercase tracking-wider mb-2">
              {post.data.category}
            </span>
            <h2 class="text-xl font-bold text-emerald-950 mb-3 hover:text-emerald-700 transition-colors">
              <a href={`/es/${post.id.replace(/^es\//, '')}/`}>{post.data.title}</a>
            </h2>
            <p class="text-emerald-800 text-sm line-clamp-3 mb-4">
              {post.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-emerald-100 flex items-center justify-between">
            <span class="text-xs text-emerald-600">
              {new Date(post.data.pubDate).toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            <a href={`/es/${post.id.replace(/^es\//, '')}/`} class="text-sm font-semibold text-emerald-700 hover:text-emerald-900">
              Leer artículo &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
